# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Required ---------------------------------------------------------------
# Supabase Postgres connection string (use the pooled one, port 6543, on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session signing secret. App refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Bearer token for /api/cron/overdue-sweeper (Vercel cron sends it automatically)
CRON_SECRET=""

# --- Seeding (npx prisma db seed) --------------------------------------------
SEED_ADMIN_EMAIL="admin@jsquarephotography.com"
SEED_ADMIN_NAME="J Square Admin"
# Min 8 chars. Seed never overwrites an existing user.
SEED_ADMIN_PASSWORD=""

# --- Company / payment details (invoices, PayNow SGQR) ------------------------
COMPANY_NAME=""
COMPANY_UEN=""
COMPANY_BANK_NAME=""
COMPANY_BANK_ACCOUNT=""
COMPANY_BANK_BRANCH_CODE=""
COMPANY_BANK_ACCOUNT_NAME=""
# GST registration number (shown on tax invoices). Optional; can also be set in Settings.
COMPANY_GST_REG_NO=""

# --- Optional: overdue-invoice alerts -----------------------------------------
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
RESEND_API_KEY=""
ALERT_EMAIL=""

# --- Required for "Forgot password" emails -------------------------------------
# Free forever: Gmail's own SMTP relay via a Google Account App Password (no paid
# email service, no domain to verify). Turn on 2-Step Verification on the Gmail
# account, then generate one at myaccount.google.com/apppasswords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Dev only: NEVER set in production ----------------------------------------
# Enables /api/admin/clean-test-data
# ALLOW_TEST_DATA_CLEANUP="true"
