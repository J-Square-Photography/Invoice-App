generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  role                String    @default("MANAGER") // SUPER_ADMIN or MANAGER
  // Which sections a MANAGER can see/use (see src/lib/permissions.ts). Ignored for SUPER_ADMIN,
  // who always has full access including Team management, which is not itself delegable.
  permissions         String[]  @default([])
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Forgot-password flow: a hash of the single-use link's token (never the raw token itself,
  // same reasoning as password hashing) plus when it stops being valid.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

// Single row (id = "default") holding the studio's payment details, editable from
// Settings. Blank fields fall back to the COMPANY_* environment defaults.
model CompanySettings {
  id                String   @id @default("default")
  companyName       String?
  uen               String?
  bankName          String?
  bankAccountNumber String?
  bankBranchCode    String?
  bankAccountName   String?
  gstRegNo          String?
  address           String?
  staticQrDataUrl   String?  @db.Text
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@map("company_settings")
}

model Client {
  id            String    @id @default(uuid())
  companyName   String
  // The printable name (e.g. "Mr Wei Ming Tan"), composed server-side from the fields below
  // whenever they are provided (see src/lib/client-name.ts). Kept as a plain column, rather than
  // computed on every read, so every existing consumer (invoice/contract PDFs, search, the client
  // list) keeps working unchanged. Older rows created before this split may hold a name here with
  // no matching salutation/firstName/lastName recorded.
  contactName   String
  salutation    String?
  firstName     String?
  lastName      String?
  // Optional: a client can be created with just a name and filled in later (multiple NULLs are allowed by the unique index)
  email         String?   @unique
  phone         String?
  uen           String?
  address       String?
  socials       String?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@map("clients")
}

model Project {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  projectType    String    @default("PORTRAIT") // legacy single type; kept in step with the first service tag
  // Services this project involves (see src/lib/service-tags.ts). Drives which
  // price presets appear when invoicing the project. Empty on older projects.
  serviceTags    String[]  @default([])
  pipelineStatus String    @default("INQUIRY")  // INQUIRY, QUOTED, BOOKED, IN_PROGRESS, DELIVERED, CLOSED
  shootDate      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]
  quotes         Quote[]
  assignments    ProjectAssignment[]
  timesheets     Timesheet[]

  @@map("projects")
}

model Invoice {
  id                  String              @id @default(uuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber       String              @unique
  subtotal            Decimal             @default(0) @db.Decimal(12, 2)
  // Sum of all discounts, and the discounts themselves in the order they were applied
  // (each with its computed amount and the running price before/after). GST is charged
  // on subtotal minus discountAmount.
  discountAmount      Decimal             @default(0) @db.Decimal(12, 2)
  discounts           Json?
  isGstApplied        Boolean             @default(true)
  gstRate             Float               @default(9)
  gstAmount           Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal             @default(0) @db.Decimal(12, 2)
  issueDate           DateTime            @default(now())
  dueDate             DateTime
  status              String              @default("DRAFT") // DRAFT, SENT, PARTIAL, PAID, VOID
  paymentMethod       String?             // BANK_TRANSFER, PAYNOW_UEN, PAYNOW_QR, PAYNOW_STATIC_QR
  // Company/bank details as they were when the invoice was issued (see
  // src/lib/payment-snapshot.ts). Null while DRAFT: drafts follow Settings.
  paymentSnapshot     Json?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               InvoiceItem[]
  paymentLogs         PaymentLog[]
  contract            Contract?
  quote               Quote?              // the quotation this invoice was made from, if any

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model PaymentLog {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid     Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime @default(now())
  paymentMethod  String?
  transactionRef String?
  notes          String?
  recordedBy     String?
  // Evidence and double-check: an optional proof image (stored in PaymentProof, so lists stay light)
  // and who confirmed the money really arrived in the bank.
  proofBytes     Int?
  verifiedAt     DateTime?
  verifiedBy     String?
  proof          PaymentProof?
  createdAt      DateTime @default(now())

  @@map("payment_logs")
}

model Contract {
  id             String          @id @default(uuid())
  invoiceId      String          @unique
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title          String
  contractBody   String
  signingToken   String          @unique
  tokenExpiresAt DateTime
  isSigned       Boolean         @default(false)
  signedAt       DateTime?
  finalPdfUrl    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  signatureAudit SignatureAudit?

  @@map("contracts")
}

model SignatureAudit {
  id                  String   @id @default(uuid())
  contractId          String   @unique
  contract            Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatureImageBase64 String
  signerName          String
  signerEmail         String?
  signerIp            String
  userAgent           String
  documentSha256      String
  signedUtcTimestamp  DateTime
  intentConfirmed     Boolean  @default(false)

  @@map("signature_audits")
}

// A price quote sent before a booking is confirmed. Same shape as an invoice (line items,
// stacked discounts, GST) but with no payments. "Convert to invoice" creates a draft
// invoice from it and links the two through invoiceId.
model Quote {
  id             String      @id @default(uuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteNumber    String      @unique // QUO-YYYY-XXXX
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  discounts      Json?
  isGstApplied   Boolean     @default(true)
  gstRate        Float       @default(9)
  gstAmount      Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(12, 2)
  issueDate      DateTime    @default(now())
  validUntil     DateTime
  status         String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED (expired is worked out from validUntil)
  notes          String?
  invoiceId      String?     @unique
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("quote_items")
}

// A screenshot/photo of a payment, shrunk in the browser before upload (a few tens of KB).
model PaymentProof {
  id        String     @id @default(uuid())
  paymentId String     @unique
  payment   PaymentLog @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  createdAt DateTime   @default(now())

  @@map("payment_proofs")
}

// What a "Revert Payment" removed, kept so the ledger is never silently lost.
model PaymentReversal {
  id             String    @id @default(uuid())
  invoiceId      String
  invoiceNumber  String
  clientName     String
  amountPaid     Decimal   @db.Decimal(12, 2)
  paymentDate    DateTime
  paymentMethod  String?
  transactionRef String?
  recordedBy     String?
  verifiedBy     String?
  reversedBy     String
  reversedAt     DateTime  @default(now())

  @@map("payment_reversals")
}

// ==================== Staff Management ====================

model Staff {
  id                String              @id @default(uuid())
  name              String
  email             String?             @unique
  phone             String?
  // FT (Full-Time), PT (Part-Time), FREELANCE - dictates how pay is calculated
  type              String              @default("PT")
  // Legacy free-text role/skills, kept for any pre-existing rows; superseded by `skills` below
  role              String?
  // Trained skill level per discipline (see src/lib/skill-levels.ts), e.g.
  // [{ discipline: "Photography", level: "Enthusiast" }, { discipline: "Videography", level: "Novice" }]
  skills            Json?
  hourlyRate        Decimal?            @db.Decimal(10, 2)
  dayRate           Decimal?            @db.Decimal(10, 2)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  payNowNumber      String?
  isActive          Boolean             @default(true)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignments       ProjectAssignment[]
  timesheets        Timesheet[]
  payslips          Payslip[]

  @@map("staff")
}

// Many-to-many: which staff are allocated to which jobs
model ProjectAssignment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // This job's specific role for this staff member, e.g. "Lead Photographer" (optional, distinct
  // from the staff member's general role/skills)
  role      String?
  createdAt DateTime @default(now())

  @@unique([projectId, staffId])
  @@map("project_assignments")
}

// A single logged shift: one staff member, one project, one day
model Timesheet {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         DateTime
  startTime    String // "HH:MM", 24-hour
  endTime      String // "HH:MM", 24-hour
  breakMinutes Int       @default(0)
  // (end - start - break), worked out and stored at save time (see src/lib/timesheet-calculations.ts)
  totalHours   Decimal   @db.Decimal(6, 2)
  notes        String?
  // Set once this shift has been rolled into a generated payslip, so it isn't double-counted
  payslipId    String?
  payslip      Payslip?  @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("timesheets")
}

// A generated pay statement for one staff member over one period, itemised for MOM-style
// compliance (basic pay math, overtime, allowances, deductions, net pay).
model Payslip {
  id            String      @id @default(uuid())
  staffId       String
  staff         Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  totalHours    Decimal     @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal     @default(0) @db.Decimal(8, 2)
  hourlyRate    Decimal     @default(0) @db.Decimal(10, 2)
  basicPay      Decimal     @default(0) @db.Decimal(12, 2)
  overtimePay   Decimal     @default(0) @db.Decimal(12, 2)
  // Itemised rows, each { label: string, amount: number }: transport/meal allowances,
  // deductions like unpaid leave or CPF contributions
  allowances    Json?
  deductions    Json?
  netPay        Decimal     @default(0) @db.Decimal(12, 2)
  status        String      @default("DRAFT") // DRAFT, PAID
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  timesheets    Timesheet[]

  @@map("payslips")
}
