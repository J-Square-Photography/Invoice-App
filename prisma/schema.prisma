generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  role                String    @default("MANAGER") // SUPER_ADMIN or MANAGER
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

// Single row (id = "default") holding the studio's payment details, editable from
// Settings. Blank fields fall back to the COMPANY_* environment defaults.
model CompanySettings {
  id                String   @id @default("default")
  companyName       String?
  uen               String?
  bankName          String?
  bankAccountNumber String?
  bankBranchCode    String?
  bankAccountName   String?
  gstRegNo          String?
  address           String?
  staticQrDataUrl   String?  @db.Text
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@map("company_settings")
}

model Client {
  id            String    @id @default(uuid())
  companyName   String
  contactName   String
  email         String    @unique
  phone         String?
  uen           String?
  address       String?
  socials       String?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@map("clients")
}

model Project {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  projectType    String    @default("PORTRAIT") // legacy single type; kept in step with the first service tag
  // Services this project involves (see src/lib/service-tags.ts). Drives which
  // price presets appear when invoicing the project. Empty on older projects.
  serviceTags    String[]  @default([])
  pipelineStatus String    @default("INQUIRY")  // INQUIRY, QUOTED, BOOKED, IN_PROGRESS, DELIVERED, CLOSED
  shootDate      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@map("projects")
}

model Invoice {
  id                  String              @id @default(uuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber       String              @unique
  subtotal            Decimal             @default(0) @db.Decimal(12, 2)
  // Sum of all discounts, and the discounts themselves in the order they were applied
  // (each with its computed amount and the running price before/after). GST is charged
  // on subtotal minus discountAmount.
  discountAmount      Decimal             @default(0) @db.Decimal(12, 2)
  discounts           Json?
  isGstApplied        Boolean             @default(true)
  gstRate             Float               @default(9)
  gstAmount           Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal             @default(0) @db.Decimal(12, 2)
  issueDate           DateTime            @default(now())
  dueDate             DateTime
  status              String              @default("DRAFT") // DRAFT, SENT, PARTIAL, PAID, VOID
  paymentMethod       String?             // BANK_TRANSFER, PAYNOW_UEN, PAYNOW_QR, PAYNOW_STATIC_QR
  // Company/bank details as they were when the invoice was issued (see
  // src/lib/payment-snapshot.ts). Null while DRAFT: drafts follow Settings.
  paymentSnapshot     Json?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               InvoiceItem[]
  paymentLogs         PaymentLog[]
  contract            Contract?

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model PaymentLog {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid     Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime @default(now())
  paymentMethod  String?
  transactionRef String?
  notes          String?
  recordedBy     String?
  createdAt      DateTime @default(now())

  @@map("payment_logs")
}

model Contract {
  id             String          @id @default(uuid())
  invoiceId      String          @unique
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title          String
  contractBody   String
  signingToken   String          @unique
  tokenExpiresAt DateTime
  isSigned       Boolean         @default(false)
  signedAt       DateTime?
  finalPdfUrl    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  signatureAudit SignatureAudit?

  @@map("contracts")
}

model SignatureAudit {
  id                  String   @id @default(uuid())
  contractId          String   @unique
  contract            Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatureImageBase64 String
  signerName          String
  signerEmail         String?
  signerIp            String
  userAgent           String
  documentSha256      String
  signedUtcTimestamp  DateTime
  intentConfirmed     Boolean  @default(false)

  @@map("signature_audits")
}
